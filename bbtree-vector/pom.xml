<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.sb</groupId>
    <artifactId>bbtree-java-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>bbtree-vector</artifactId>
  <name>bbtree-vector</name>
  <description>Node scans for bbtree that use the Java Vector API (jdk.incubator.vector).</description>

  <properties>
    <!-- javac with release 21 does not see incubator modules. Compile against the running JDK. -->
    <maven.compiler.release>25</maven.compiler.release>
    <vector.module>--add-modules=jdk.incubator.vector</vector.module>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.sb</groupId>
      <artifactId>bbtree</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- javac always warns that an incubator module is in use, so -Werror is off here. -->
          <compilerArgs combine.self="override">
            <arg>${vector.module}</arg>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>${vector.module}</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
